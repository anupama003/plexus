# Copy this file to .env:  cp .env.example .env

# Signs the demo sign-in tokens. Set any long random string so sign-ins survive restarts.
# Generate one:  python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Max questions per person per minute (stops abuse on a public URL)
RATE_LIMIT_PER_MIN=120

# Local Docker FalkorDB (see README). For FalkorDB Cloud, paste host/port/user/password.
FALKOR_HOST=localhost
FALKOR_PORT=6479
FALKOR_USERNAME=
FALKOR_PASSWORD=
GRAPH_NAME=plexus

# Sign-in tokens expire after this many hours
TOKEN_TTL_HOURS=12
# How often the watcher agent re-checks CISA's list against the graph
WATCH_EVERY_MIN=15

# The chat's main agent: Gemini chooses plexus's graph tools over MCP. Free key: https://aistudio.google.com/apikey
# Without it, the chat uses the graph agent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when a model is overloaded or out of its daily free quota
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
